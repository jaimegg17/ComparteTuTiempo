# API base URL (frontend -> backend)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Auth0 (web app)
AUTH0_SECRET=your-32-byte-random-secret
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.compartetutiempo.com

# Google Maps JavaScript API key (maps and Places Autocomplete in location fields)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Public contact email shown on the TFG information page
NEXT_PUBLIC_CONTACT_EMAIL=your-contact-email@example.com
