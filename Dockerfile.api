FROM node:22-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm deploy:api:build

ENV NODE_ENV=production
EXPOSE 3001

CMD ["pnpm", "--filter", "@comparte-tu-tiempo/api", "start:prod:migrate"]
